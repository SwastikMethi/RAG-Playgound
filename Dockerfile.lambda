FROM public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1 AS adapter

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH" \
    AWS_LWA_PORT=8080 \
    AWS_LWA_READINESS_CHECK_PATH=/api/v1/health \
    AWS_LWA_INVOKE_MODE=response_stream \
    RAG_ARTIFACT_ROOT=/tmp/artifacts
COPY --from=adapter /lambda-adapter /opt/extensions/lambda-adapter
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY workers ./workers
COPY contracts ./contracts
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev
COPY alembic.ini ./
COPY migrations ./migrations
COPY config ./config
RUN groupadd --gid 10001 rag && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin rag
USER rag
CMD ["python", "-m", "app.lambda_entry"]
