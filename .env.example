# Generate a token with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
RAG_APP_TOKEN=
RAG_MODE=live
RAG_DATABASE_URL=postgresql+psycopg://rag:local-development-only@127.0.0.1:6544/ragplayground
RAG_QDRANT_URL=http://127.0.0.1:6344
RAG_ARTIFACT_ROOT=.data/artifacts
RAG_PROFILES_PATH=config/profiles.yaml
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RAG_MASTER_KEY=
RAG_DATABASE_HOST_ALLOWLIST=[]
# Exact owner-approved relation and column policy. Keep empty to disable database sources.
RAG_DATABASE_RELATION_ALLOWLIST=[]
# Example: [{"host":"db.internal","port":5432,"database":"knowledge","schema":"public","relation":"articles","columns":["id","body"]}]
RAG_PROVIDER_HOST_ALLOWLIST=["api.openai.com"]
# Referenced by your server-owned provider profiles, never returned to the browser.
OPENAI_API_KEY=
