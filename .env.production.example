# Create the real file with python3 deploy/configure.py; never commit it.
RAG_DOMAIN=your-name.duckdns.org
ACME_EMAIL=you@example.com
RAG_TURNSTILE_SITE_KEY=
RAG_TURNSTILE_SECRET_KEY=
RAG_MASTER_KEY=
