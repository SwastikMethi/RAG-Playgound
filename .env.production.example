OCI_DATA_VOLUME_ID=
OCI_COMPARTMENT_ID=
# Optional exact administrator-approved PostgreSQL snapshot destinations.
RAG_DATABASE_HOST_ALLOWLIST=[]
RAG_DATABASE_RELATION_ALLOWLIST=[]
