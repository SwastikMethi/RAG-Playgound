{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "technique": {
      "type": "string",
      "enum": [
        "bm25",
        "dense",
        "hybrid",
        "hybrid_rerank",
        "parent_child",
        "pageindex"
      ]
    },
    "chunking": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "fixed_tokens",
                "headings"
              ]
            },
            "size_tokens": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            },
            "overlap_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "tokenizer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "tokenizer_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "strategy",
            "size_tokens",
            "overlap_tokens",
            "tokenizer",
            "tokenizer_revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "embedding": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "dimensions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "document_prefix": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            },
            "query_prefix": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            }
          },
          "required": [
            "profile_id",
            "model",
            "dimensions",
            "document_prefix",
            "query_prefix"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "search": {
      "type": "object",
      "properties": {
        "candidate_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "context_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "bm25": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "k1": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 3
                },
                "b": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "epsilon": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "tokenizer_revision": {
                  "const": "lexical_v1"
                }
              },
              "required": [
                "k1",
                "b",
                "epsilon",
                "tokenizer_revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "dense": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "metric": {
                  "const": "cosine"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "exact",
                    "hnsw"
                  ]
                },
                "hnsw_ef": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 8,
                      "maximum": 1024
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "min_score": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "metric",
                "mode",
                "hnsw_ef",
                "min_score"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "rrf": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "k": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "weights": {
                  "const": "equal"
                }
              },
              "required": [
                "k",
                "weights"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "candidate_k",
        "context_k",
        "bm25",
        "dense",
        "rrf"
      ],
      "additionalProperties": false
    },
    "reranker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "model_revision": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
