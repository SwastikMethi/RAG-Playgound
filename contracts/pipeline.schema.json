            "index_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "selection_profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "selection_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "sdk_version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_documents": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "max_nodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "max_calls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "required": [
            "index_profile_id",
            "index_model",
            "selection_profile_id",
            "selection_model",
            "sdk_version",
            "max_documents",
            "max_depth",
            "max_nodes",
            "max_calls",
            "max_pages"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "context_budget_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16000
        },
        "prompt_id": {
          "const": "grounded_answer_v1"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "profile_id",
        "model",
        "temperature",
        "max_output_tokens",
        "context_budget_tokens",
        "prompt_id",
        "seed"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "lane_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000
        }
      },
      "required": [
        "lane_timeout_ms"
      ],
      "additionalProperties": false
    }
