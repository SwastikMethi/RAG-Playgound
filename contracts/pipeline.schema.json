          "required": [
            "model",
            "model_revision",
            "max_input_tokens",
            "device"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "parent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "max_parent_tokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 4096
